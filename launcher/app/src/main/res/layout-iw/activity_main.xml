<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/scenicWallpaper"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/scenicShade"
        android:background="@drawable/dashboard_wallpaper_shade"
        android:importantForAccessibility="no" />

    <!-- Time-of-day backdrop, drawn once a minute (config.xml sky_intensity; 0 keeps it hidden). -->
    <com.gathin.tvhome.SkyView
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Cinematic top shelf (cinematic_home): the focused dock app's artwork, a few pixels across and
         stretched over the screen, which softens it like a blur without the cost of one. Hidden otherwise. -->
    <ImageView
        android:id="@+id/heroArt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:alpha="0"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Race-weekend panel (a theme's race_calendar, see RaceWeekend): in the free space under the clock,
         shown only from shortly before a weekend's first session until the race is over. Updated once a
         minute with the clock, never animated. -->
    <LinearLayout
        android:id="@+id/racePanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        android:layout_marginStart="60dp"
        android:layout_marginTop="158dp"
        android:orientation="vertical"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- A short kerb-red bar, the panel's one accent. -->
            <View
                android:layout_width="3dp"
                android:layout_height="13dp"
                android:layout_marginEnd="10dp"
                android:id="@+id/raceBar"
                android:background="@drawable/race_bar" />

            <TextView
                android:id="@+id/raceKicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.02"
                android:textAllCaps="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/raceHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:fontFamily="@string/font_light"
            android:letterSpacing="-0.01"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/raceSessions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:singleLine="true"
            android:textColor="#99FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.12" />

        <!-- game_day: one dot per turn when the panel rotates between games (and the F1 weekend). -->
        <LinearLayout
            android:id="@+id/racePager"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Cinematic top shelf: darkens the edge behind the shelf and the lower half, so the text and the
         dock stay readable over the artwork. -->
    <View
        android:id="@+id/heroScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <!-- Top shelf: the focused dock app's name, positioned above the dock in code. -->
    <LinearLayout
        android:id="@+id/hero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="68dp"
        android:orientation="vertical"
        android:alpha="0">

        <TextView
            android:id="@+id/heroName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="48sp"
            android:fontFamily="@string/font_light"
            android:letterSpacing="-0.02"
            android:includeFontPadding="false"
            android:singleLine="true" />

        <!-- Cinematic shelf only: when the app was last opened, and the dock position dots. -->
        <TextView
            android:id="@+id/heroMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginTop="12dp"
            android:singleLine="true"
            android:textColor="#B3FFFFFF"
            android:textSize="15sp"
            android:fontFamily="@string/font_light"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/heroDots"
            android:layout_width="wrap_content"
            android:layout_height="6dp"
            android:layout_marginStart="0dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>

    <com.gathin.tvhome.DashboardScrollView
        android:id="@+id/dashboardScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="false">
        <LinearLayout
            android:id="@+id/dashboardHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="56dp"
            android:paddingEnd="56dp"
            android:paddingTop="20dp"
            android:clipChildren="false"
            android:clipToPadding="false">
        <!-- No clipping down to the pills: with advanced effects a focused pill scales up past its row. -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/topButtons"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <!-- The header texts use gravity left, not start: the launcher lays out left to right
                     (no supportsRtl), and with start a right-to-left script such as Arabic would move to the
                     right edge of these full-width lines instead of staying under the clock. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                <ImageButton
                    android:id="@+id/btnProfile"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="0dp"
                    android:padding="5dp"
                    android:background="@drawable/profile_button_bg"
                    android:src="@drawable/ic_google_account"
                    android:contentDescription="@string/google_accounts"
                    android:focusable="true"
                    android:clickable="true" />
                <TextView
                    android:id="@+id/greeting"
                    android:includeFontPadding="false"
                    android:gravity="left"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginStart="10dp"
                    android:textColor="#8CFFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@string/font_medium"
                    android:letterSpacing="0.02"
                    android:textAllCaps="false" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false">

                    <TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="#FFFFFFFF"
                        android:textSize="22sp"
                        android:fontFamily="@string/font_light"
                        android:letterSpacing="-0.04"
                        android:includeFontPadding="false" />

                    <TextClock
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginBottom="0dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textColor="#B3FFFFFF"
                        android:textSize="15sp"
                        android:fontFamily="@string/font_medium"
                        android:letterSpacing="0.08"
                        android:textAllCaps="false" />

                    <View
                        android:id="@+id/clockDivider"
                        android:layout_width="1dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="0dp"
                        android:background="#33FFFFFF" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginBottom="0dp"
                        android:orientation="vertical">

                        <!-- Shamsi date ("27 Mehr 1405"), shown when shamsi_date is on. -->
                        <TextView
                            android:id="@+id/shamsiDate"
                            android:gravity="left"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textColor="#E6FFFFFF"
                            android:textSize="17sp"
                            android:fontFamily="@string/font_regular"
                            android:letterSpacing="0.02"
                            android:includeFontPadding="false"
                            android:visibility="gone" />

                        <TextClock
                            android:id="@+id/date"
                            android:gravity="left"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="@bool/date_single_line"
                            android:maxLines="2"
                            android:lineSpacingExtra="6dp"
                            android:ellipsize="end"
                            android:format12Hour="@string/date_format_home"
                            android:format24Hour="@string/date_format_home"
                            android:textColor="#A6FFFFFF"
                            android:textSize="11sp"
                            android:fontFamily="@string/font_regular"
                            android:letterSpacing="0.14"
                            android:textAllCaps="false" />

                        <!-- Lunar date ("Lunar 13/9 Ã‚Â· Year of the Horse"), shown when lunar_date is on. -->
                        <TextView
                            android:id="@+id/lunarDate"
                            android:gravity="left"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textColor="#80FFFFFF"
                            android:textSize="11sp"
                            android:fontFamily="@string/font_regular"
                            android:letterSpacing="0.14"
                            android:textAllCaps="false"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Shown only when show_stats is on. Outside leftBlock, so the top buttons stay level with the clock
                 row; gone, it takes no space. -->
            <TextView
                android:id="@+id/stats"
                android:layout_width="wrap_content"
                android:layout_below="@id/leftBlock"
                android:layout_alignStart="@id/leftBlock"
                android:gravity="left"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#D9FFFFFF"
                android:textSize="11sp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.04"
                android:focusable="false"
                android:visibility="gone" />

            <TextView
                android:id="@+id/remoteBattery"
                android:includeFontPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:drawableStart="@drawable/ic_remote_battery"
                android:drawablePadding="5dp"
                android:text="@string/remote_battery_unknown"
                android:textColor="#B3B6BF"
                android:textSize="11sp"
                android:fontFamily="@string/font_medium"
                android:focusable="false" />

            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_below="@id/remoteBattery"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="0dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopButton"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopButton"
                    android:maxWidth="180dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnVpn"
                    style="@style/TopButton"
                    android:visibility="gone"
                    android:singleLine="true"
                    android:text="@string/vpn"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnReorder"
                    style="@style/TopButtonIcon"
                    android:contentDescription="@string/reorder"
                    android:drawableStart="@drawable/ic_swap_vert"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnLibraryTop"
                    style="@style/TopButtonIcon"
                    android:visibility="gone"
                    android:contentDescription="@string/app_library"
                    android:drawableStart="@drawable/ic_apps_pill"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnBluetooth"
                    style="@style/TopButtonIcon"
                    android:contentDescription="@string/bluetooth_settings"
                    android:drawableStart="@drawable/ic_bluetooth"
                    android:nextFocusDown="@+id/grid" />

                <com.gathin.tvhome.NotificationButton
                    android:id="@+id/btnNotifications"
                    style="@style/TopButtonIcon"
                    android:contentDescription="@string/notification_center"
                    android:drawableStart="@drawable/ic_notifications"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/TopButton"
                    android:text="@string/settings"
                    android:drawableStart="@drawable/ic_settings"
                    android:nextFocusDown="@+id/grid" />
            </LinearLayout>
        </RelativeLayout>

        <com.gathin.tvhome.DashboardBanner
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:text="@string/dashboard_favourites"
            android:textSize="16sp"
            android:textColor="#F0F1F5"
            android:fontFamily="@string/font_medium" />


        <FrameLayout
            android:id="@+id/dashboardGridFrame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="-16dp"
                android:paddingTop="10dp"
                android:paddingBottom="12dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
            <com.gathin.tvhome.WebsiteRow
                android:id="@+id/websiteRow"
                android:layout_width="match_parent"
                android:layout_height="104dp" />
            <TextView
                android:id="@+id/dashboardAppsHeading"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:text="@string/dashboard_apps"
                android:textSize="16sp"
                android:textColor="#F0F1F5"
                android:fontFamily="@string/font_medium" />
        </FrameLayout>
        </LinearLayout>
    </com.gathin.tvhome.DashboardScrollView>

    <!-- The single floating glass highlight that springs between tiles. -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
